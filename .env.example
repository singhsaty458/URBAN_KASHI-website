PORT=8080
HOST=127.0.0.1
DATABASE_PATH=./data/store.sqlite
# Server-only photo directory. Blank is valid: defaults to private product-images
# beside DATABASE_PATH (normally ./data/product-images), outside public/static roots.
# Persist and back up BOTH the database and this photo directory.
# Managed uploads default to 200 MiB; no quota environment variable is supported.
UPLOADS_PATH=
NODE_ENV=development
# For local customer/admin setup use terminal prompts; never commit credentials.
# Enable COOKIE_SECURE=true behind production HTTPS.
COOKIE_SECURE=false

# Optional Razorpay configuration: server environment only; never use VITE_ keys.
# Leave empty for COD-only operation. All three values are required for online checkout.
# Owner: configure test keys privately first, enable capture, and register a public
# HTTPS POST /api/payments/webhook with its matching signing secret in Razorpay.
# Merchant KYC/activation and method eligibility still apply; configuration is not verification.
# No live/sandbox payments have been tested. Never send secrets in chat or commit them.
# Only the public KEY_ID is returned to Checkout; both secrets stay server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=